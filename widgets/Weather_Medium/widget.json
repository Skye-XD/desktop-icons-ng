{
  "id": "com.desktop.ding.weather.medium",
  "name": "Weather (Medium)",
  "description": "Show current weather conditions for a user-selected location in a medium layout",
  "kind": "html",
  "entry": "index.html",
  "prefs": "prefs.html",
  "version": 4,
  "pinnable": true,
  "chrome": {
    "showMoveButton": false
  },
  "defaultWidth": 320,
  "defaultHeight": 200,
  "defaultConfig": {
    "location": {
      "label": "",
      "lat": null,
      "lon": null
    },
    "units": "system",
    "refreshMinutes": 30,
    "animationsEnabled": false,
    "cache": null
  },
  "permissions": [
    "internet"
  ]
}
