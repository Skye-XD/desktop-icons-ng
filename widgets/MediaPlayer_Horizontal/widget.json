{
  "id": "media.player.horizontal",
  "name": "Media Player",
  "description": "Show current playing music info via MPRIS",
  "kind": "html",
  "defaultWidth": 320,
  "defaultHeight": 100,
  "author": "xiaozhangup, Sundeep Mediratta",
  "version": "1.2",
  "pinnable": true,
  "defaultConfig": {
    "textColor": "#ffffff",
    "progressColor": "#ffffff",
    "bgColor": "#000000",
    "bgAlpha": 0.3,
    "mediaCache": null
  },
  "prefs": "prefs.html",
  "backend": {
    "command": "gjs",
    "argv": [
      "-m",
      "mediaBackend.js"
    ]
  }
}
