{
  "id": "media.player.horizontal",
  "name": "Media Player Horizontal",
  "description": "Show current playing music info via MPRIS in a horizontal layout",
  "kind": "html",
  "defaultWidth": 320,
  "defaultHeight": 100,
  "author": "xiaozhangup, Sundeep Mediratta",
  "version": "1.3",
  "pinnable": true,
  "chrome": {
    "showMoveButton": false
  },
  "defaultConfig": {
    "textColor": "#ffffff",
    "progressColor": "#ffffff",
    "bgColor": "#000000",
    "bgAlpha": 0.3,
    "mediaCache": null
  },
  "prefs": "prefs.html",
  "backend": {
    "command": "gjs",
    "argv": [
      "-m",
      "mediaBackend.js"
    ]
  }
}
