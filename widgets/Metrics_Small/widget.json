{
  "id": "metrics-small",
  "kind": "html",
  "name": "Metrics (Small)",
  "description": "Show system performance metrics in a compact layout",
  "defaultWidth": 260,
  "defaultHeight": 160,
  "version": 3,
  "pinnable": true,
  "chrome": {
    "showMoveButton": false
  },
  "prefs": "prefs.html",
  "backend": {
    "command": "gjs",
    "argv": [
      "-m",
      "metricsBackend.js"
    ]
  }
}
