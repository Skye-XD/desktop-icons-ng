{
  "id": "calendar.today",
  "name": "Calendar",
  "description": "Today’s calendar events at a glance",
  "kind": "html",

  "defaultWidth": 260,
  "defaultHeight": 320,
  "pinnable": true,
  "chrome": {
    "showMoveButton": false
  },

  "author": "Sundeep Mediratta",
  "version": "1.1",

  "defaultConfig": {
    "headerColor": "#f5f6f8",
    "eventColor": "#f5f6f8",
    "panelColor": "#ffffff",
    "panelAlpha": 0.06,
    "nextColor": "#ffffff",
    "calendarCache": null
  },

  "backend": {
    "command": "gjs",
    "argv": [
      "-m",
      "calendarBackend.js"
    ]
  },

  "prefs": "prefs.html"
}
