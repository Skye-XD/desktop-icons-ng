# MT: LibreTranslate
#: data/com.desktop.ding.desktop.in:21
msgid "Show<>Hide"
msgstr "Gebräuchliche Bezeichnung"

# MT: LibreTranslate
#: data/com.desktop.ding.desktop.in:33
msgid "Preferences"
