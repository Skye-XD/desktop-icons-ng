"priečinky;správca;usporiadať;skryť;zobraziť;spúšťač;skratky;"

#: data/com.desktop.ding.desktop.in:21
msgid "Show<>Hide"
msgstr "Zobraziť<>Skryť"

#: data/com.desktop.ding.desktop.in:33
